@{
}

@model RACEDAY_PART3_.Models.Entites.Users

@if (Model is null)
{
    <p>No users found with the userid</p>
}
else
{
    <h1>Edit user</h1>

    <form method="post">

        <div class="mt-3">
            <label class="form-label">UserId</label>
            <input type="text" class="form-control" asp-for="UserId" readonly />
        </div>

        <div class="mt-3">
            <label class="form-label">Name</label>
            <input type="text" class="form-control" asp-for="Name" />
        </div>

        <div class="mt-3">
            <label class="form-label">Surname</label>
            <input type="text" class="form-control" asp-for="Surname" />
        </div>

        <div class="mt-3">
            <label class="form-label">Email</label>
            <input type="text" class="form-control" asp-for="Email" />
        </div>

        <div class="mt-3">
            <label class="form-label">PasswordHash</label>
            <input type="text" class="form-control" asp-for="PasswordHash" />
        </div>

        <div class="mt-3">
            <label class="form-label">Role</label>
            <input type="text" class="form-control" asp-for="Role" />
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Save</button>

            <button type="submit" class="btn btn-danger ms-3" 
            asp-action="Delete" asp-controller="User">Delete</button>
        </div>
    </form>
}

