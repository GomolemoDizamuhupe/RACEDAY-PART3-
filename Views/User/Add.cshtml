@{
}
@*
    Helps us to access the AddUserViewModel
*@
@model RACEDAY_PART3_.Models.AddUserViewModel

<h1>Registering user</h1>

<form method="post">

    <div class="mt-3">
        <label class="form-label">Name</label>
        <input type="text" class="form-control" asp-for="Name"/>
    </div>

    <div class="mt-3">
        <label class="form-label">Surname</label>
        <input type="text" class="form-control" asp-for="Surname"/>
    </div>

    <div class="mt-3">
        <label class="form-label">Email</label>
        <input type="text" class="form-control" asp-for="Email"/>
    </div>

    <div class="mt-3">
        <label class="form-label">PasswordHash</label>
        <input type="text" class="form-control" asp-for="PasswordHash"/>
    </div>

    <div class="mt-3">
        <label class="form-label">Role</label>
        <input type="text" class="form-control" asp-for="Role"/>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Register</button>
    </div>
</form>